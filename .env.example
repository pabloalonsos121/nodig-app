# Copy to .env (or set these in your host's dashboard) and fill in real values.

# Port the server listens on (default 3000).
PORT=3000

# Secret used to sign session cookies. MUST be set to a long random string in
# production so sessions stay valid across restarts and can't be forged.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Password for the /admin.html organization-approval page. Change this.
ADMIN_PASSWORD=nodig-admin

# Set to "production" when deployed (enables secure cookies over HTTPS).
NODE_ENV=development

# Optional: override where the SQLite file lives (default ./data/nodig.db).
# DATABASE_PATH=/var/data/nodig.db
